NUDIBRANCH_ENV=development
NUDIBRANCH_PUBLIC_URL=http://localhost:5173
# Leave as is if api and web ui all run in the same stack, point NUDIBRANCH_API_URL it at the API host's ip and port (e.g. http://192.168.1.50:8000) only if you're running the web UI separate from the API.
NUDIBRANCH_API_URL=http://api:8000
NUDIBRANCH_DB_PATH=/app/config/nudibranch.sqlite
NUDIBRANCH_LOG_PATH=/app/config/nudibranch.log

# Change these before installing, this is the webui password for the 'admin' account
NUDIBRANCH_FIRST_ADMIN_PIN=nudibranchsarecool123
# CHANGE THIS BEFORE EXPOSING TO THE INTERNET OR IT GIVES FULL ACCESS TO THE API
NUDIBRANCH_FULL_ACCESS_API_KEY=placeholder-put-a-key-here-please

# optional, add the ip/url and key from your jellyfin install, or leave blank for standalone nudibranch
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# SLSKD_API_KEY must match the value you set for SLSKD_API_KEY in the slskd block further down — same value, two consumers.
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=

# slskd settings, set this to your account, an account will be created if the username is unused already
# you can reuse your account details from elsewhere but it will log you out
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
# slskd web ui login creds, whatever you want them to be
SLSKD_AUTH_USERNAME=
SLSKD_AUTH_PASSWORD=

# acoustid api key, optional, but highly recommended, free
ACOUSTID_API_KEY=

# spotify api creds for playlist import, requires a premium subscription
# optional, spotify import still mostly works without it, but is less reliable
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Disabling this breaks ios notifications and automations and stuff
APNS_ENABLED=true 

# Push notifications are delivered through a small proxy, 
APNS_PROXY_URL=https://nbpushproxy.pophosting.xyz/
